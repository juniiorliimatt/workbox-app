server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # $http_host (com a porta), não $host: sem a porta o Spring enxerga o Origin do browser (ex.: http://192.168.100.36:7053)
    # como de outro site e aplica a allowlist de CORS (só localhost) → 403 "Invalid CORS request" pelo celular/LAN.
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Authorization $http_authorization;

    # Front e cada backend no mesmo origin do ponto de vista do browser (evita CORS) —
    # cada serviço resolve pelo nome no docker compose. Nginx escolhe o prefixo mais
    # específico automaticamente (não importa a ordem dos location abaixo), então
    # /api/v1/revenues etc sempre ganham de /api/ quando os dois batem a requisição —
    # sem essas rotas específicas, tudo caía no workbox-api (que não tem esses
    # endpoints) e voltava 500 em vez de ir pro budget-service de verdade.
    # budget-service e forza-telemetry-service entram por variável + resolver: o nginx
    # resolve o nome só na requisição, então o front sobe mesmo se um desses serviços não
    # existir no ambiente (ex.: compose de produção) — a rota só devolve 502. Com variável
    # no proxy_pass a URI original é repassada como está (mesmos paths nos dois lados).
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $budget_upstream ${BUDGET_SERVICE_UPSTREAM};
    set $forza_upstream ${FORZA_SERVICE_UPSTREAM};
    set $backup_upstream ${BACKUP_SERVICE_UPSTREAM};

    location /api/v1/revenues {
        proxy_pass $budget_upstream;
    }

    location /api/v1/spendings {
        proxy_pass $budget_upstream;
    }

    location /api/v1/revenue-types {
        proxy_pass $budget_upstream;
    }

    location /api/v1/spending-types {
        proxy_pass $budget_upstream;
    }

    location /api/v1/budget-rules {
        proxy_pass $budget_upstream;
    }

    # forza-telemetry-service: sessões (/api/v1/sessions) e leitura ao vivo (/api/v1/live).
    location /api/v1/sessions {
        proxy_pass $forza_upstream;
    }

    location /api/v1/live {
        proxy_pass $forza_upstream;
    }

    location /api/v1/tuning {
        proxy_pass $forza_upstream;
    }

    # backup-service: geração/lista/download de backups do banco (só ADMIN). A geração roda o pg_dump
    # na hora, então o timeout de leitura é folgado; o download não é bufferizado em disco.
    location /api/v1/backups {
        proxy_pass $backup_upstream;
        proxy_read_timeout 300s;
        proxy_request_buffering off;
        proxy_buffering off;
    }

    location /api/ {
        proxy_pass ${WORKBOX_API_UPSTREAM}/api/;
    }

    location / {
        try_files $uri /index.html;
    }
}
